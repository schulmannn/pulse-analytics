FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    COLLECTOR_STATE_DIR=/data

WORKDIR /app

# Оба набора зависимостей — mtproto (telethon/fastapi: collector импортирует mtproto.service)
# и собственный коллектора (qrcode — команда `login` внутри контейнера падала с ImportError,
# когда образ ставил только mtproto-зависимости) — зафиксированы ОДНИМ lock-файлом с хешами,
# скомпилированным pip-compile из mtproto/requirements.txt + collector/requirements.txt
# (те остаются человекочитаемым источником, команда регенерации — в collector/requirements.txt).
COPY collector/requirements.lock ./collector/requirements.lock
RUN pip install --no-cache-dir --require-hashes -r collector/requirements.lock

COPY mtproto ./mtproto
COPY collector ./collector

RUN useradd --system --uid 10001 --create-home collector \
    && mkdir -p /data \
    && chown -R collector:collector /app /data

USER collector
VOLUME ["/data"]

ENTRYPOINT ["python", "collector/pulse_collector.py"]
CMD ["run"]
